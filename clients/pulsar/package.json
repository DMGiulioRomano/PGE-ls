{
  "name": "pge-ls",
  "main": "./lib/main",
  "version": "0.3.0",
  "description": "Autocompletion, hover e diagnostica per i file PGE_*.yaml del Python Granular Engine.",
  "keywords": [
    "granular synthesis",
    "yaml",
    "csound",
    "audio",
    "lsp",
    "language-server"
  ],
  "repository": "https://github.com/DMGiulioRomano/PGE-ls",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "dependencies": {
    "@savetheclocktower/atom-languageclient": "^1.17.18"
  },
  "configSchema": {
    "pythonPath": {
      "type": "string",
      "default": "python",
      "order": 1,
      "title": "Python Path",
      "description": "Percorso all'eseguibile Python. Usa 'python3' o il path completo se necessario."
    },
    "granularSrcPath": {
      "type": "string",
      "default": "",
      "order": 2,
      "title": "Granular src Path",
      "description": "Percorso alla directory 'src' del Python Granular Engine. Se vuoto, usa lo snapshot JSON incluso nel pacchetto."
    },
    "snapshotPath": {
      "type": "string",
      "default": "",
      "order": 3,
      "title": "Snapshot Path",
      "description": "Percorso a un file snapshot JSON alternativo. Usato solo se granularSrcPath e' vuoto."
    }
  },
  "consumedServices": {
    "linter-indie": {
      "versions": {
        "2.0.0": "consumeLinterV2"
      }
    },
    "datatip": {
      "versions": {
        "0.1.0": "consumeDatatip"
      }
    },
    "signature-help": {
      "versions": {
        "0.1.0": "consumeSignatureHelp"
      }
    },
    "atom-ide-busy-signal": {
      "versions": {
        "0.1.0": "consumeBusySignal"
      }
    }
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "4.0.0": "provideAutocomplete"
      }
    },
    "code-actions": {
      "versions": {
        "0.1.0": "provideCodeActions"
      }
    },
    "code-highlight": {
      "versions": {
        "0.1.0": "provideCodeHighlight"
      }
    },
    "definitions": {
      "versions": {
        "0.1.0": "provideDefinitions"
      }
    },
    "find-references": {
      "versions": {
        "0.1.0": "provideFindReferences"
      }
    },
    "outline-view": {
      "versions": {
        "0.1.0": "provideOutlines"
      }
    }
  }
}
